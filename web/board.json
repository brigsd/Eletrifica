.","group":"Alimentacao","solids":[{"shape":"cyl","cx":15.239991770404444,"cy":20.319989027205928,"z":1.6,"dia":6.3,"h":11.0,"colour":"#2b3a8c"}],"top":12.6,"pins":[{"n":1,"net":"+12V"},{"n":2,"net":"GND"}],"pin_xy":[[15.24,19.05],[15.24,21.59]]},{"ref":"C3","title":"Capacitor 470 nF","desc":"Capacitor de entrada do LM7805.","group":"Alimentacao","solids":[{"shape":"box","cx":21.84398820424637,"cy":20.573988890045996,"z":1.6,"w":3.2,"d":7.0,"h":8.0,"colour":"#204a86"}],"top":9.6,"pins":[{"n":1,"net":"+12V"},{"n":2,"net":"GND"}],"pin_xy":[[21.844,23.114],[21.844,18.034]]},{"ref":"C4","title":"Capacitor 100 nF","desc":"Capacitor de saida do LM7805. E o unico capacitor do trilho de 5 V: nao ha nenhum eletrolitico de reservatorio nesse trilho.","group":"Alimentacao","solids":[{"shape":"box","cx":39.115978877371404,"cy":20.319989027205928,"z":1.6,"w":3.0,"d":5.0,"h":6.5,"colour":"#204a86"}],"top":8.1,"pins":[{"n":1,"net":"+5V"},{"n":2,"net":"GND"}],"pin_xy":[[39.116,22.86],[39.116,17.78]]},{"ref":"C14","title":"Capacitor 100 nF","desc":"Desacoplamento no trilho de 12 V.","group":"Alimentacao","solids":[{"shape":"box","cx":16.382991153184776,"cy":6.476996502421889,"z":1.6,"w":3.0,"d":5.0,"h":6.5,"colour":"#204a86"}],"top":8.1,"pins":[{"n":1,"net":"+12V"},{"n":2,"net":"GND"}],"pin_xy":[[16.383,9.017],[16.383,3.937]]},{"ref":"R1","title":"Resistor 10 k","desc":"Liga o gate do Q1 ao source, para o gate nao ficar solto quando o GPIO estiver em alta impedancia.","group":"Laser","solids":[{"shape":"box","cx":53.33997119641555,"cy":17.90699033022522,"z":1.6,"w":6.5,"d":2.3,"h":2.3,"colour":"#c8a06a"}],"top":3.9,"pins":[{"n":1,"net":"SRC_Q1"},{"n":2,"net":"GATE_Q1"}],"pin_xy":[[58.42,17.907],[48.26,17.907]]},{"ref":"R2","title":"Resistor 10 k","desc":"Em serie entre o GPIO13 e o gate do Q1. Com a capacitancia de entrada do IRFZ44N isso da uma constante de tempo perto de 15 us, o que limita bastante o PWM.","group":"Laser","solids":[{"shape":"box","cx":43.5609764770727,"cy":18.795